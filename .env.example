# Copie para .env e preencha. Gere segredos com: openssl rand -hex 32

# URL pública do proxy (sem barra no final).
SATOSA_BASE_URL=https://localhost

# Caminhos NO HOST do certificado TLS e da chave privada.
SSL_CERT_PATH=
SSL_KEY_PATH=

# Chave de criptografia do cookie de estado do SATOSA.
SATOSA_STATE_ENCRYPTION_KEY=
# Senha de criptografia das sessões/tokens do frontend OIDC.
OIDC_TOKEN_ENCRYPTION_PASSWORD=

# Chave de API do cuidapp (o SATOSA a usa para consultar o cuidapp).
CUID_API_KEY=
# Sem caracteres especiais de URL (@ : / ? #), pois entra nas URIs postgresql://.
POSTGRES_PASSWORD=
